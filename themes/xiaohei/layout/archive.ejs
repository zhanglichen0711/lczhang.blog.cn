<section class="archive">
  <header class="page-head">
    <p class="eyebrow">分类</p>
    <h1>
      <% if (is_category()) { %><%= page.category %>
      <% } else if (is_tag()) { %>标签 · <%= page.tag %>
      <% } else { %>归档<% } %>
    </h1>
    <p><%= page.posts.length %> 篇</p>
  </header>
  <%
    let lastYear = '';
    page.posts.each(function (post) {
      const y = date(post.date, 'YYYY');
  %>
    <% if (y !== lastYear) { lastYear = y; %>
      <h2 class="year"><%= y %></h2>
    <% } %>
    <a class="archive-item" href="<%= url_for(post.path) %>">
      <time><%= date(post.date, 'MM-DD') %></time>
      <span><%= post.title %></span>
      <% if (post.categories && post.categories.length) { %>
        <em><%= post.categories.data[post.categories.length - 1].name %></em>
      <% } %>
    </a>
  <% }) %>
</section>

<% if (page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>">较新</a><% } else { %><span></span><% } %>
    <span class="pager-info"><%= page.current %> / <%= page.total %></span>
    <% if (page.next) { %><a href="<%= url_for(page.next_link) %>">较早</a><% } else { %><span></span><% } %>
  </nav>
<% } %>
