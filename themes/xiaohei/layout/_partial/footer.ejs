<footer class="site-footer">
  <div class="footer-inner">
    <p><%= theme.footer || (config.author + ' · ' + config.title) %></p>
    <p class="footer-links">
      <% if (theme.social && theme.social.github) { %>
        <a href="<%= theme.social.github %>" target="_blank" rel="noopener">GitHub</a>
      <% } %>
      <a href="<%= url_for('/atom.xml') %>">RSS</a>
      <a href="<%= url_for('/about/') %>">关于</a>
    </p>
  </div>
</footer>
