<%
  // 规范化当前路径（去掉 index.html、统一结尾斜杠），用于精确高亮
  var curPath = '/' + String(page.path || '').replace(/index\.html$/, '').replace(/\/+$/, '/');

  function normPath(p) {
    return String(p || '').replace(/index\.html$/, '').replace(/\/+$/, '/');
  }
  function isActive(itemPath) {
    var target = normPath(itemPath);
    return curPath === target || curPath.indexOf(target) === 0;
  }
  // 一级分类下是否有二级命中当前路径（用于默认展开该一级的二级）
  function childActive(item) {
    return (item.children || []).some(function (c) { return isActive(c.path); });
  }

  const icons = {
    dot: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg>',
    book: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 5a3 3 0 0 1 3-2h11v16H8a3 3 0 0 0-3 3V5z"/><path d="M8 3v16"/></svg>',
    code: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 16l-4-4 4-4M16 8l4 4-4 4M13 5l-2 14"/></svg>',
    layout: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/></svg>',
    server: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>',
    db: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/></svg>',
    box: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/></svg>',
    net: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/><circle cx="12" cy="12" r="2.2"/><path d="M8 7l3 4M16 7l-3 4M10 14l-2 3M14 14l2 3"/></svg>',
    bot: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 8V5M9 13h.01M15 13h.01M9 17h6"/></svg>',
    rocket: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2M14 6l4-4 4 4-4 4M12 10l2 2M9 15l-3 3M14 5l5 5"/></svg>',
    news: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h12v13H6a2 2 0 0 1-2-2V7z"/><path d="M16 10h4v8a2 2 0 0 1-2 2h-2"/><path d="M7 11h6M7 15h4"/></svg>',
    job: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/></svg>',
    home: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>',
    user: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.2-3 3.6-4.5 7-4.5S17.8 16 19 19"/></svg>',
    link: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.5.1l1.4-1.4a5 5 0 0 0-7-7L10.6 6"/><path d="M14 11a5 5 0 0 0-7.5-.1L5.1 12.3a5 5 0 0 0 7 7L13.4 18"/></svg>'
  };
%>
<aside class="sidebar" id="siteNav">
  <% (theme.sidebar || []).forEach(function (group) { %>
    <div class="side-group-wrap">
      <div class="side-group">
        <span class="side-group-ico"><%- icons[group.icon] || icons.book %></span>
        <span class="side-group-name"><%= group.label %></span>
      </div>
      <div class="side-children">
        <% (group.children || []).forEach(function (item) { %>
          <% const hasKids = item.children && item.children.length; %>
          <% const l1Active = isActive(item.path); %>
          <% const l2Open = childActive(item); %>
          <div class="side-l1">
            <% if (hasKids) { %>
              <button class="side-l1-row <%= l1Active ? 'active' : '' %>" type="button" data-l1="<%= item.name %>" aria-expanded="<%= l2Open ? 'true' : 'false' %>">
                <span class="side-ico"><%- icons[item.icon] || icons.dot %></span>
                <span class="side-l1-name"><%= item.name %></span>
                <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="side-l2 <%= l2Open ? 'open' : '' %>">
                <% item.children.forEach(function (child) { %>
                  <a class="side-item <%= isActive(child.path) ? 'active' : '' %>" href="<%= url_for(child.path) %>">
                    <span class="side-ico"><%- icons[child.icon] || icons.dot %></span>
                    <span><%= child.name %></span>
                  </a>
                <% }) %>
              </div>
            <% } else { %>
              <a class="side-l1-row side-l1-link <%= l1Active ? 'active' : '' %>" href="<%= url_for(item.path) %>">
                <span class="side-ico"><%- icons[item.icon] || icons.dot %></span>
                <span class="side-l1-name"><%= item.name %></span>
              </a>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
</aside>
<div class="nav-backdrop" id="navBackdrop" hidden></div>
